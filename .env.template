# Every setting here is OPTIONAL.
# With none of them set, the app starts its own open-source LiveKit server
# (https://github.com/livekit/livekit) and generates its API key/secret.

# --- Live subtitles (Whisper, inside this app) ---------------------------------
# faster-whisper model: tiny.en, base.en, small.en (default, ~470 MB, downloaded once
# into LIVEKIT_HOME/models), medium.en, or a local model directory.
# WHISPER_MODEL=small.en
# CPU threads per transcription, and transcriptions at once (people speaking together).
# WHISPER_THREADS=8
# WHISPER_WORKERS=2

# --- Translating words picked in the subtitles (a local LLM via Ollama) --------
# Default: http://127.0.0.1:11434, or http://host.docker.internal:11434 in a container.
# OLLAMA_URL=
# Any chat model pulled into Ollama (ollama pull qwen2.5:7b).
# OLLAMA_MODEL=qwen2.5:7b

# Admin passcode for /settings (API key/secret, media IP override, restart, log).
# Leave empty and /settings only shows the server status.
ADMIN_PASSCODE=

# IP address browsers send audio and face data to (LiveKit rtc.node_ip).
# Behind re-ddns it comes automatically from EXTERNAL_IP (the Docker host's LAN IP).
# LIVEKIT_NODE_IP=

# Fixed API key/secret, e.g. to share this server with other apps.
# The secret must be at least 32 characters.
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Ports. In Docker, publish the media ports on the host: TCP 7681 and UDP 7682.
# (Below the avatar chat app's 7780-7782; the audio and video chat apps use
# 7880-7882 and 7980-7982.)
# LIVEKIT_PORT=7680
# LIVEKIT_RTC_TCP_PORT=7681
# LIVEKIT_RTC_UDP_PORT=7682

# livekit-server binary. Linux downloads this release from GitHub on first start;
# macOS uses the one on PATH (brew install livekit).
# LIVEKIT_SERVER_BIN=
# LIVEKIT_SERVER_VERSION=1.13.7

# Directory for runtime files (binary, keys, config, server log, speech model).
# LIVEKIT_HOME=

# LiveKit URL handed to browsers (default: this app's own backend URL, which relays /rtc).
# LIVEKIT_PUBLIC_URL=
